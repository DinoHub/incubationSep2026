# Copy to .env and edit. docker compose reads .env automatically.
#
# Against the bundled Keycloak (docker compose --profile dev up), the defaults
# in docker-compose.yaml already work and you do not need this file at all.
# It is for pointing the same server at a real provider.

# The issuer, exactly as it appears in the "iss" claim of tokens it mints.
# Trailing slashes matter to some providers — copy it from the provider console.
OIDC_ISSUER=https://your-tenant.example.com/

# The identifier this server is registered under. Leave unset and ANY token the
# issuer signed is accepted, including one minted for a different service.
OIDC_AUDIENCE=mcp-country-info

# Dotted path to the claim carrying the caller's roles. Provider defaults:
#   Keycloak  realm_access.roles   (the default below)
#   Auth0     permissions
#   Okta      scp
#   Entra ID  roles
OIDC_ROLES_CLAIM=realm_access.roles

# Only needed for a provider that does not publish
# /.well-known/openid-configuration, or when the issuer URL is not reachable
# from inside this container — which is the case for the bundled Keycloak, and
# why docker-compose.yaml sets it by default. Set it EMPTY here when you switch
# to a real provider, or the compose default will keep pointing key lookups at
# a Keycloak that is not running:
OIDC_JWKS_URL=
# OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json

# How this server is reachable from outside. Fills in the Protected Resource
# Metadata document.
SERVER_URL=http://localhost:8001
